{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "AWS_REGION": "ap-northeast-1",
    "AWS_PROFILE": "default",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "global.anthropic.claude-fable-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "jp.anthropic.claude-haiku-4-5-20251001-v1:0",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "global.anthropic.claude-opus-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "global.anthropic.claude-opus-5"
  },
  "permissions": {
    "allow": [
      "Bash(aws --version)",
      "Bash(aws sts *)",
      "Bash(brew info *)",
      "Bash(brew list *)",
      "Bash(colima list *)",
      "Bash(colima start *)",
      "Bash(colima status *)",
      "Bash(colima stop *)",
      "Bash(command -v *)",
      "Bash(dig *)",
      "Bash(docker info *)",
      "Bash(docker stats *)",
      "Bash(docker version *)",
      "Bash(echo *)",
      "Bash(gh api *)",
      "Bash(gh auth *)",
      "Bash(gh pr *)",
      "Bash(gh repo *)",
      "Bash(gh run *)",
      "Bash(gh variable *)",
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git check-ignore *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git mv *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git show *)",
      "Bash(git switch *)",
      "Bash(mise which *)",
      "Bash(uv --version)"
    ]
  },
  "theme": "dark",
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  }
}
